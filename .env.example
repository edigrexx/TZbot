BOT_TOKEN=123456789:AA...
OPENROUTER_API_KEY=sk-or-v1-...
TIMEZONES=Almaty:Asia/Almaty,MSK:Europe/Moscow,Bishkek:Asia/Bishkek,Vietnam:Asia/Ho_Chi_Minh
DEFAULT_TZ=Asia/Almaty

# Необязательно: зона автора по username или Telegram ID.
# Если автор есть в списке, «в 15:00» без явной зоны считается по его зоне, а не по DEFAULT_TZ.
USER_TIMEZONES=

# Модель OpenRouter и запасные (через запятую; пустое значение — без запасных).
# OPENROUTER_MODEL=google/gemini-3.1-flash-lite
# OPENROUTER_FALLBACK_MODELS=google/gemini-2.5-flash-lite
# Глубина рассуждений: none | minimal | low | medium | high. Пусто — не передавать.
# OPENROUTER_REASONING_EFFORT=
# LOG_LEVEL=INFO
